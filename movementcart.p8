pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
--player properties--
player={
	xpos=63,
	ypos=63,
	flipx=false,
	flipy=false,
	sp=1,
	}
end

function _update()
--player horisontal movement--
	if btn(➡️) then
	player.xpos+=1
	player.sp=3
	end
	if btn(⬅️) then
	player.xpos-=1
	player.sp=5
	end
--player vertical movement--
	if btn(⬆️) then
	player.ypos-=1
	player.sp=2
	end
	if btn(⬇️) then
	player.ypos+=1
	player.sp=4
	end
end

function _draw()
	cls(1)
	spr(player.sp,player.xpos,player.ypos,1,1,player.flipx,player.flipy)
end
