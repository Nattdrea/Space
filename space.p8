function shoot()
 if ship.sp == 2 then
  shootup()
 end
 if ship.sp == 4 then
	 shootdown()
	end
	if ship.sp == 3 then
	 shootright()
	end
	if ship.sp == 5 then
	 shootleft()
	end
end

--directions shooting--
function shootup()
    add(bullets,{
        x=ship.x+4,
        y=ship.y+4,
        dx=0,
        dy=-4
    })
end

function shootdown()
				add(bullets,{
								x=ship.x+4,
								y=ship.y+4,
								dx=0,
								dy=4
				})
end

function shootright()
				add(bullets,{
								x=ship.x+4,
								y=ship.y+4,
								dx=4,
								dy=0
				})
end

function shootleft()
				add(bullets,{
								x=ship.x+4,
								y=ship.y+4,
								dx=-4,
								dy=0
				})
end

function update_bullets()

    if fire_timer > 0 then
        fire_timer -= 1
    end

    if btn(4) and fire_timer <= 0 then
        shoot()
        energy = max(0, energy - energy_drain)
        fire_timer = fire_rate
    end

    for b in all(bullets) do

        b.y += b.dy
        b.x += b.dx

        if b.x < 0 or b.x > 127
								or b.y < 0 or b.y > 127 then
    							del(bullets,b)

        else
        				local hit = false
												
            for d in all(debris) do

    											if abs(b.x-d.x)<3
    											and abs(b.y-d.y)<3 then

        										del(bullets,b)
        										split_debris(d)
        										
        										register_debris_shot()
        									 
        									 hit = true
        										break
    											end
												end
												
												if not hit then
												
												   for d in all(small_debris) do

    											   if abs(b.x-d.x)<2
    											   and abs(b.y-d.y)<2 then

        										   del(bullets,b)
        										   del(small_debris,d)
                     
                     register_debris_shot()


        										   add(pickups,{
																							 x=d.x-4,
																							 y=d.y-4,
 																							spr=7
																								})
																								
        										   break
    											   end
												  end
												end  
        end
    end
end

function draw_pickups()
 for p in all(pickups) do
  spr(p.spr,p.x,p.y)
 end
end

function update_pickups()
 for p in all(pickups) do
  if abs(ship.x-p.x)<4
  and abs(ship.y-p.y)<4 then
   del(pickups,p)
		 energy = min(max_energy,energy + energy_gain)

  end
 end
end

function draw_bullets()

    for b in all(bullets) do
        spr(8,b.x-4,b.y-4)
    end

end

 
