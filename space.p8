pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
ship = {
    x=64,
    y=64,

    vx=0,
    vy=0,

    accel=0.15,
    drag=0.90,
    max_speed=2,

    sp=1,
    flipx=false,
    flipy=false
}


-->8
function _init()
    debris = {}
    small_debris = {}
    bullets = {}
    game_over = false
    fire_rate = 30 --Parameter. Can change anytime we want.
    fire_timer = 0
end
-->8
function update_ship()

    -- up
    if btn(2) then
        ship.vy -= ship.accel
        ship.sp = 2
    end

    -- down
    if btn(3) then
        ship.vy += ship.accel
        ship.sp = 4
    end

    -- left
    if btn(0) then
        ship.vx -= ship.accel
        ship.sp = 5
    end

    -- right
    if btn(1) then
        ship.vx += ship.accel
        ship.sp = 3
    end

    -- speed limit
    ship.vx = mid(
        -ship.max_speed,
        ship.vx,
        ship.max_speed
    )

    ship.vy = mid(
        -ship.max_speed,
        ship.vy,
        ship.max_speed
    )

    -- drag
    ship.vx *= ship.drag
    ship.vy *= ship.drag

    -- movement
    ship.x += ship.vx
    ship.y += ship.vy

    -- sprite-sized world borders
    if ship.x < 0 then
        ship.x = 0
        ship.vx = 0
    end

    if ship.x > 120 then
        ship.x = 120
        ship.vx = 0
    end

    if ship.y < 0 then
        ship.y = 0
        ship.vy = 0
    end

    if ship.y > 120 then
        ship.y = 120
        ship.vy = 0
    end

end
-->8
function update_debris_system()

    if #debris < 10 and rnd(1) < 0.02 then
        spawn_debris()
    end

    for d in all(debris) do
        update_debris(d)
    end

    check_debris_collisions()
end

-- large debris bounce or split on contact
function check_debris_collisions()
    for i=1,#debris-1 do
        for j=i+1,#debris do
            local a=debris[i]
            local b=debris[j]
            local dx=b.x-a.x
            local dy=b.y-a.y
            local dist2=dx*dx+dy*dy

            -- each large debris has radius 3
            if dist2<36 then
                -- 50% chance both pieces split
                if rnd(1)<0.5 then
                    -- one breaks north/south,
                    -- the other east/west
                    split_debris(a,"vertical")
                    split_debris(b,"horizontal")
                    -- the list changed, so finish
                    -- checking pairs next frame
                    return
                end

                local dist=sqrt(dist2)
                local nx=1
                local ny=0
                if dist>0 then
                    nx=dx/dist
                    ny=dy/dist
                end

                -- push circles out of overlap
                local overlap=(6-dist)/2+0.01
                a.x-=nx*overlap
                a.y-=ny*overlap
                b.x+=nx*overlap
                b.y+=ny*overlap

                -- bounce away along collision line
                local closing=(a.dx-b.dx)*nx
                    +(a.dy-b.dy)*ny
                local push=max(0.3,closing)
                a.dx-=nx*push
                a.dy-=ny*push
                b.dx+=nx*push
                b.dy+=ny*push
            end
        end
    end
end

function update_small_debris()
    for d in all(small_debris) do
        d.x += d.dx
        d.y += d.dy

        if d.x < 0 or d.x > 127
        or d.y < 0 or d.y > 127 then
            del(small_debris,d)
        end
    end
end
-->8
function spawn_debris()

    local d={}
    local side=flr(rnd(4))
    local speed=0.1+rnd(0.3)

    if side==0 then
        d.x=0
        d.y=rnd(128)
        d.dx=speed
        d.dy=0

    elseif side==1 then
        d.x=127
        d.y=rnd(128)
        d.dx=-speed
        d.dy=0

    elseif side==2 then
        d.x=rnd(128)
        d.y=0
        d.dx=0
        d.dy=speed

    else
        d.x=rnd(128)
        d.y=127
        d.dx=0
        d.dy=-speed
    end

    add(debris,d)
end

function update_debris(d)
    d.x += d.dx
    d.y += d.dy

    if d.x < 0 or d.x > 127
    or d.y < 0 or d.y > 127 then
        del(debris,d)
    end
end
-->8

function draw_debris()

    for d in all(debris) do
        circfill(d.x,d.y,3,7)
    end

end

function draw_small_debris()
    for d in all(small_debris) do
        circfill(d.x,d.y,1,6)
    end
end
-->8
function _update()

if game_over then
return 
end
    update_ship()
    update_debris_system()
    update_small_debris()
    update_bullets()
    check_ship_collision()

end
-->8
function draw_ship()

    spr(
        ship.sp,
        ship.x,
        ship.y,
        1,
        1,
        ship.flipx,
        ship.flipy
    )

end

function _draw()

    cls(0)

    -- stars
    pset(10,20,7)
    pset(40,90,6)
    pset(90,30,7)
    pset(110,80,13)

    draw_ship()
    draw_debris()
    draw_small_debris()
    draw_bullets()
    
    if game_over then
       rectfill (20,50,108,78,0)
       rect(20,50,108,78,8)
       print("game over",44,62,8)
       end

end
-->8
function shoot()
 if ship.sp == 2 then
  shootup()
 end
 if ship.sp == 4 then
	 shootdown()
	end
	if ship.sp == 3 then
	 shootright()
	end
	if ship.sp == 5 then
	 shootleft()
	end
end

--directions shooting--
function shootup()
    add(bullets,{
        x=ship.x+4,
        y=ship.y+4,
        dx=0,
        dy=-4
    })
end

function shootdown()
				add(bullets,{
								x=ship.x+4,
								y=ship.y+4,
								dx=0,
								dy=4
				})
end

function shootright()
				add(bullets,{
								x=ship.x+4,
								y=ship.y+4,
								dx=4,
								dy=0
				})
end

function shootleft()
				add(bullets,{
								x=ship.x+4,
								y=ship.y+4,
								dx=-4,
								dy=0
				})
end

function update_bullets()

    if fire_timer > 0 then
        fire_timer -= 1
    end

    if btn(4) and fire_timer <= 0 then
        shoot()
        fire_timer = fire_rate
    end

    for b in all(bullets) do

        b.y += b.dy
        b.x += b.dx

        if b.y < 0 then

            del(bullets,b)

        else

            for d in all(debris) do

                if abs(b.x-d.x)<3
                and abs(b.y-d.y)<3 then

                    del(bullets,b)
                    split_debris(d)

                    break

                end

            end

        end

    end

end

function draw_bullets()

    for b in all(bullets) do
        circfill(b.x,b.y,1,10)
    end

end-->8

 
-->8
function check_ship_collision()

    for d in all(debris) do

        local dx = ship.x + 4 - d.x
        local dy = ship.y + 4 - d.y

        if dx*dx + dy*dy < 20 then
            game_over = true
        end

    end

end
-->8
function split_debris(d,axis)
    local speed=max(0.5,sqrt(d.dx*d.dx+d.dy*d.dy)*1.5)

    -- when two large debris collide, the first
    -- splits north/south and the second east/west.
    -- bullets still use the original auto direction.
    if axis=="vertical" or
      (axis==nil and abs(d.dx)>abs(d.dy)) then
        add(small_debris,{x=d.x,y=d.y-2,dx=0,dy=-speed})
        add(small_debris,{x=d.x,y=d.y+2,dx=0,dy=speed})
    else
        add(small_debris,{x=d.x-2,y=d.y,dx=-speed,dy=0})
        add(small_debris,{x=d.x+2,y=d.y,dx=speed,dy=0})
    end

    del(debris,d)
end

