pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
ship = {
    x=64,
    y=64,

    vx=0,
    vy=0,

    accel=0.15,
    drag=0.90,
    max_speed=2,

    sp=1,
    flipx=false,
    flipy=false
}


-->8
function _init()
    debris = {}
    bullets = {}
    game_over = false
end
-->8
function update_ship()

    -- up
    if btn(2) then
        ship.vy -= ship.accel
        ship.sp = 2
    end

    -- down
    if btn(3) then
        ship.vy += ship.accel
        ship.sp = 4
    end

    -- left
    if btn(0) then
        ship.vx -= ship.accel
        ship.sp = 5
    end

    -- right
    if btn(1) then
        ship.vx += ship.accel
        ship.sp = 3
    end

    -- speed limit
    ship.vx = mid(
        -ship.max_speed,
        ship.vx,
        ship.max_speed
    )

    ship.vy = mid(
        -ship.max_speed,
        ship.vy,
        ship.max_speed
    )

    -- drag
    ship.vx *= ship.drag
    ship.vy *= ship.drag

    -- movement
    ship.x += ship.vx
    ship.y += ship.vy

    -- sprite-sized world borders
    if ship.x < 0 then
        ship.x = 0
        ship.vx = 0
    end

    if ship.x > 120 then
        ship.x = 120
        ship.vx = 0
    end

    if ship.y < 0 then
        ship.y = 0
        ship.vy = 0
    end

    if ship.y > 120 then
        ship.y = 120
        ship.vy = 0
    end

end
-->8
function update_debris_system()

    if #debris < 10 and rnd(1) < 0.02 then
        spawn_debris()
    end

    for d in all(debris) do
        update_debris(d)
        remove_offscreen_debris(d)
    end
end
-->8
function spawn_debris()

    local d={}
    local side=flr(rnd(4))
    local speed=0.1+rnd(0.3)

    if side==0 then
        d.x=0
        d.y=rnd(128)
        d.dx=speed
        d.dy=0

    elseif side==1 then
        d.x=127
        d.y=rnd(128)
        d.dx=-speed
        d.dy=0

    elseif side==2 then
        d.x=rnd(128)
        d.y=0
        d.dx=0
        d.dy=speed

    else
        d.x=rnd(128)
        d.y=127
        d.dx=0
        d.dy=-speed
    end

    add(debris,d)
end

function update_debris(d)
    d.x += d.dx
    d.y += d.dy
end

function remove_offscreen_debris(d)

    if d.x < 0 or d.x > 127
    or d.y < 0 or d.y > 127 then
        del(debris,d)
    end

end
-->8

function draw_debris()

    for d in all(debris) do
        circfill(d.x,d.y,3,7)
    end

end
-->8
function _update()

if game_over then
return 
end
    update_ship()
    update_debris_system()
    update_bullets()
    check_ship_collision()

end
-->8
function draw_ship()

    spr(
        ship.sp,
        ship.x,
        ship.y,
        1,
        1,
        ship.flipx,
        ship.flipy
    )

end

function _draw()

    cls(0)

    -- stars
    pset(10,20,7)
    pset(40,90,6)
    pset(90,30,7)
    pset(110,80,13)

    draw_ship()
    draw_debris()
    draw_bullets()
    
    if game_over then
       rectfill (20,50,108,78,0)
       rect(20,50,108,78,8)
       print("game over",44,62,8)
       end

end
-->8
function shoot()
    add(bullets,{
        x=ship.x+4,
        y=ship.y+4,
        dy=-4
    })
end

function update_bullets()

    if btnp(4) then
        shoot()
    end

    for b in all(bullets) do

        b.y += b.dy

        if b.y < 0 then

            del(bullets,b)

        else

            for d in all(debris) do

                if abs(b.x-d.x)<3
                and abs(b.y-d.y)<3 then

                    del(bullets,b)
                    del(debris,d)

                    break

                end

            end

        end

    end

end

function draw_bullets()

    for b in all(bullets) do
        circfill(b.x,b.y,1,10)
    end

end
-->8
function check_ship_collision()

    for d in all(debris) do

        if abs(ship.x - d.x) < 6
        and abs(ship.y - d.y) < 6 then

            game_over = true

        end

    end

end
