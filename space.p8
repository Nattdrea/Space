function check_ship_collision()

    for d in all(debris) do

        local dx = ship.x + 4 - d.x
        local dy = ship.y + 4 - d.y

        if dx*dx + dy*dy < 20 then
            damage_ship(50)
        end
    end
end

function check_small_debris_ship_collision()

    for d in all(small_debris) do

        local dx = ship.x + 4 - d.x
        local dy = ship.y + 4 - d.y

        if dx*dx + dy*dy < 16 then
            damage_ship(25)
        end
    end
end

function damage_ship(amount)
      if damage_cooldown > 0 then
        return
    end

    energy = max(0, energy - amount)

    damage_cooldown = 30

 
end
-->8
function split_debris(d,axis)
    local speed=max(0.5,sqrt(d.dx*d.dx+d.dy*d.dy)*1.5)

    -- when two large debris collide, the first
    -- splits north/south and the second east/west.
    -- bullets still use the original auto direction.
    if axis=="vertical" or
      (axis==nil and abs(d.dx)>abs(d.dy)) then
        add(small_debris,{x=d.x,y=d.y-2,dx=0,dy=-speed})
        add(small_debris,{x=d.x,y=d.y+2,dx=0,dy=speed})
    else
        add(small_debris,{x=d.x-2,y=d.y,dx=-speed,dy=0})
        add(small_debris,{x=d.x+2,y=d.y,dx=speed,dy=0})
    end

    del(debris,d)
end

-->8
function restart_game()

    -- reset ship
    ship.x = 64
    ship.y = 64
    ship.vx = 0
    ship.vy = 0
    ship.sp = 1

    -- clear objects
    debris = {}
    small_debris = {}
    bullets = {}
    pickups = {}

    -- reset energy
    energy = max_energy
    
    -- reset counter
    debris_shot_count = 0
    total_debris_shot = 0
    level = 1

    debris_spawn_chance = 0.02
    debris_speed_bonus = 0
    -- reset timers
    fire_timer = 0
    damage_cooldown = 0

    -- restart game
    game_over = false

end
-->8
function register_debris_shot()

    debris_shot_count += 1
    total_debris_shot += 1

    if debris_shot_count >= 10 then

        -- next level
        level += 1
        debris_shot_count = 0

        -- restore half energy
        energy = min(max_energy, energy + 50)

        -- increase difficulty
        debris_spawn_chance = min(
            0.06,
            debris_spawn_chance + 0.002
        )

        debris_speed_bonus += 0.03

    end

end
