__lua__
ship = {
    x=64,
    y=64,

    vx=0,
    vy=0,

    accel=0.15,
    drag=0.90,
    max_speed=2,

    sp=1,
    flipx=false,
    flipy=false
}


-->8
function _init()
    debris = {}
    small_debris = {}
    bullets = {}
    game_over = false
    on_title = true
    fire_rate = 30 --Parameter. Can change anytime we want.
    fire_timer = 0
    damage_cooldown = 0
    debris_shot_count = 0
    pickups={}
    level = 1
    total_debris_shot = 0

    debris_spawn_chance = 0.02
    debris_speed_bonus = 0

    -- Energy.
    max_energy = 100
    energy = max_energy
    energy_drain = 5
    energy_gain = 15
end
-->8
function update_ship()
    local moving = false

    -- up
    if btn(2) then
        ship.vy -= ship.accel
        ship.sp = 2
        moving = true
    end

    -- down
    if btn(3) then
        ship.vy += ship.accel
        ship.sp = 4
        moving = true
    end

    -- left
    if btn(0) then
        ship.vx -= ship.accel
        ship.sp = 5
        moving = true
    end

    -- right
    if btn(1) then
        ship.vx += ship.accel
        ship.sp = 3
        moving = true
    end

    -- speed limit
    ship.vx = mid(
        -ship.max_speed,
        ship.vx,
        ship.max_speed
    )

    ship.vy = mid(
        -ship.max_speed,
        ship.vy,
        ship.max_speed
    )

    -- drag
    ship.vx *= ship.drag
    ship.vy *= ship.drag

    -- movement
    ship.x += ship.vx
    ship.y += ship.vy

    -- sprite-sized world borders
    if ship.x < 0 then
        ship.x = 0
        ship.vx = 0
    end

    if ship.x > 120 then
        ship.x = 120
        ship.vx = 0
    end

    if ship.y < 0 then
        ship.y = 0
        ship.vy = 0
    end

    if ship.y > 120 then
        ship.y = 120
        ship.vy = 0
    end

     if moving then

        energy = max(0, energy - energy_drain/30)
    end
end
-->8
function update_debris_system()

    if #debris < 10 and rnd(1) < debris_spawn_chance then
       spawn_debris()
    end

    for d in all(debris) do
        update_debris(d)
    end

    check_debris_collisions()
end

-- large debris bounce or split on contact
function check_debris_collisions()
    for i=1,#debris-1 do
        for j=i+1,#debris do
            local a=debris[i]
            local b=debris[j]
            local dx=b.x-a.x
            local dy=b.y-a.y
            local dist2=dx*dx+dy*dy

            -- each large debris has radius 3
            if dist2<36 then
                -- 50% chance both pieces split
                if rnd(1)<0.5 then
                    -- one breaks north/south,
                    -- the other east/west
                    split_debris(a,"vertical")
                    split_debris(b,"horizontal")
                    -- the list changed, so finish
                    -- checking pairs next frame
                    return
                end

                local dist=sqrt(dist2)
                local nx=1
                local ny=0
                if dist>0 then
                    nx=dx/dist
                    ny=dy/dist
                end

                -- push circles out of overlap
                local overlap=(6-dist)/2+0.01
                a.x-=nx*overlap
                a.y-=ny*overlap
                b.x+=nx*overlap
                b.y+=ny*overlap

                -- bounce away along collision line
                local closing=(a.dx-b.dx)*nx
                    +(a.dy-b.dy)*ny
                local push=max(0.3,closing)
                a.dx-=nx*push
                a.dy-=ny*push
                b.dx+=nx*push
                b.dy+=ny*push
            end
        end
    end
end

function check_small_large_debris_collision()

    for big in all(debris) do
        for small in all(small_debris) do

            local dx = small.x - big.x
            local dy = small.y - big.y

            if dx*dx + dy*dy < 16 then

                del(small_debris,small)

                if rnd(1) < 2/3 then
                    split_debris(big)
                    return
                end
            end
        end
    end
end


-->8
function spawn_debris()

    local d={}
    local side=flr(rnd(4))
    local speed=0.1+rnd(0.3)+debris_speed_bonus

    if side==0 then
        d.x=0
        d.y=rnd(128)
        d.dx=speed
        d.dy=0

    elseif side==1 then
        d.x=127
        d.y=rnd(128)
        d.dx=-speed
        d.dy=0

    elseif side==2 then
        d.x=rnd(128)
        d.y=0
        d.dx=0
        d.dy=speed

    else
        d.x=rnd(128)
        d.y=127
        d.dx=0
        d.dy=-speed
    end

    add(debris,d)
end

function update_debris(d)
    d.x += d.dx
    d.y += d.dy

    if d.x < 0 or d.x > 127
    or d.y < 0 or d.y > 127 then
        del(debris,d)
    end
end

function update_small_debris()
    for d in all(small_debris) do
        d.x += d.dx
        d.y += d.dy

        if d.x < 0 or d.x > 127
        or d.y < 0 or d.y > 127 then
            del(small_debris,d)
        end
    end
end
-->8

function draw_debris()

    for d in all(debris) do
        circfill(d.x,d.y,3,4)
    end

end

function draw_small_debris()
    for d in all(small_debris) do
        circfill(d.x,d.y,2,4)
    end
end
-->8
function _update()

    -- wait for x before starting game
    if on_title then
        if btnp(5) then
            restart_game()
            on_title = false
        end
        return
    end

    -- game over controls
    if game_over then

        if btnp(5) then
            restart_game()
        end

        return
    end

    if damage_cooldown > 0 then
        damage_cooldown -= 1
    end

 if energy <= 0 then
        game_over = true
 end

    update_ship()
    update_debris_system()
    update_small_debris()
    update_bullets()
    update_pickups()

    check_ship_collision()
    check_small_debris_ship_collision()
    check_small_large_debris_collision()

end
-->8
function draw_ship()

    spr(
        ship.sp,
        ship.x,
        ship.y,
        1,
        1,
        ship.flipx,
        ship.flipy
    )

end

function draw_energy_bar()

    local bar_w = 60
    local bar_h = 5

    local x = 34
    local y = 120

    -- border
    rect(
        x-1,
        y-1,
        x+bar_w,
        y+bar_h,
        7
    )

    -- fill
    local fill_w =
        (energy/max_energy) * bar_w

    rectfill(
        x,
        y,
        x+fill_w,
        y+bar_h-1,
        11
    )

end

function title_arrow(x,y,dir)
    if dir=="left" then
        line(x+1,y,x+8,y,7)
        line(x+1,y,x+4,y-3,7)
        line(x+1,y,x+4,y+3,7)
    elseif dir=="right" then
        line(x,y,x+7,y,7)
        line(x+7,y,x+4,y-3,7)
        line(x+7,y,x+4,y+3,7)
    elseif dir=="up" then
        line(x+4,y-3,x+4,y+4,7)
        line(x+4,y-3,x+1,y,7)
        line(x+4,y-3,x+7,y,7)
    elseif dir=="down" then
        line(x+4,y-3,x+4,y+4,7)
        line(x+4,y+4,x+1,y+1,7)
        line(x+4,y+4,x+7,y+1,7)
    end
end


function draw_space_title()
    local letters={
        {"01111","10000","10000","01110","00001","00001","11110"}, -- s
        {"11110","10001","10001","11110","10000","10000","10000"}, -- p
        {"01110","10001","10001","11111","10001","10001","10001"}, -- a
        {"01111","10000","10000","10000","10000","10000","01111"}, -- c
        {"11111","10000","10000","11110","10000","10000","11111"}  -- e
    }
    local scale=3
    local start_x=20
    local start_y=12
    for i=1,5 do
        local glyph=letters[i]
        local gx=start_x+(i-1)*18
        for row=1,7 do
            for col=1,5 do
                if sub(glyph[row],col,col)=="1" then
                    local x=gx+(col-1)*scale
                    local y=start_y+(row-1)*scale
                    rectfill(x+2,y+2,x+scale+1,y+scale+1,1)
                    rectfill(x,y,x+scale-1,y+scale-1,7)
                end
            end
        end
    end
end

function draw_title_screen()
    cls(0)

    for i=1,30 do
        local x=(i*47+13)%128
        local y=(i*31+7)%128
        pset(x,y, i%3==0 and 6 or 5)
    end
    --title
    draw_space_title()
    line(22,40,105,40,12)
    spr(1,60,45)

    print("press x to start",33,68,10)

    -- controls (centered beneath the space title)
    rectfill(33,75,94,127,1)
    rect(33,75,94,127,5)
    print("controls",48,77,12)
    title_arrow(40,88,"left")
    print("left",55,85,7)
    title_arrow(40,97,"right")
    print("right",55,94,7)
    title_arrow(40,106,"up")
    print("up",55,103,7)
    title_arrow(40,115,"down")
    print("down",55,112,7)
    -- align shoot key and label with the arrow/label columns
    print("z:",42,120,10)
    print("shoot",55,120,10)

end 
function _draw()

    if on_title then
        draw_title_screen()
        return
    end

    cls(0)
    
 if not game_over then

    print("next level: "..(10-debris_shot_count), 2, 2, 7)

    print("level: "..level, 2, 10, 11)

end
    
     -- stars
    pset(10,20,7)
    pset(40,90,6)
    pset(90,30,7)
    pset(110,80,13)

    draw_ship()
    draw_debris()
    draw_small_debris()
    draw_bullets()
    draw_energy_bar()
    draw_pickups()
    
   
if game_over then

    rectfill(15,40,113,88,0)
    rect(15,40,113,88,8)

    print("game over",
        64-#("game over")*2, 46, 8)

    print("final level: "..level,
        64-#("final level: "..level)*2,
        56, 7)

    print("total debris: "..total_debris_shot,
        64-#("total debris: "..total_debris_shot)*2,
        66, 7)

    print("press x to restart",
        64-#("press x to restart")*2,
        78, 11)

end

end
